
@model System.Data.DataTable

@{
    ViewBag.Title = "Pedidos por empleado";
}

<h2>Pedidos por empleado</h2>

@using (Html.BeginForm("Index", "Empleado", FormMethod.Get))
{
    <div class="form-group">
        <label for="anio">Ingrese el año:</label>
        <input type="number"
               id="anio"
               name="anio"
               value="@ViewBag.Anio"
               min="1900"
               max="2100"
               class="form-control"
               required />

        <br />
        <button type="submit" class="btn btn-primary">
            Consultar
        </button>
    </div>
}

@if (Model != null && Model.Rows.Count > 0)
{
    <h4>Resultados del año @ViewBag.Anio</h4>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Código de empleado</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Año</th>
                <th>Cantidad de pedidos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow fila in Model.Rows)
            {
                <tr>
                    <td>@fila["EmployeeID"]</td>
                    <td>@fila["FirstName"]</td>
                    <td>@fila["LastName"]</td>
                    <td>@fila["Anio"]</td>
                    <td>@fila["CantidadPedidos"]</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay pedidos para el año consultado.</p>
}

<p>
    @Html.ActionLink("Volver al inicio", "Index", "Home")
</p>
