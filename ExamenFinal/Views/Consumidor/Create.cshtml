
@model ExamenFinal.Models.Consumidor

@{
    ViewBag.Title = "Agregar consumidor";
}

<h2>Agregar consumidor</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-info">
        @TempData["Mensaje"]
    </div>
}

@using (Html.BeginForm("Create", "Consumidor", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.dnicont, "DNI")
        @Html.TextBoxFor(m => m.dnicont, new
        {
            @class = "form-control",
            maxlength = "8",
            required = "required"
        })
        @Html.ValidationMessageFor(m => m.dnicont)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.nomcont, "Nombre")
        @Html.TextBoxFor(m => m.nomcont, new
        {
            @class = "form-control",
            required = "required"
        })
        @Html.ValidationMessageFor(m => m.nomcont)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.apecont, "Apellido")
        @Html.TextBoxFor(m => m.apecont, new
        {
            @class = "form-control",
            required = "required"
        })
        @Html.ValidationMessageFor(m => m.apecont)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.emailcont, "Correo electrónico")
        @Html.TextBoxFor(m => m.emailcont, new
        {
            @class = "form-control",
            type = "email"
        })
        @Html.ValidationMessageFor(m => m.emailcont)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.idpais, "Código de país")
        @Html.TextBoxFor(m => m.idpais, new
        {
            @class = "form-control",
            maxlength = "3",
            placeholder = "Ejemplo: 001"
        })
        @Html.ValidationMessageFor(m => m.idpais)
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Guardar consumidor
    </button>

    @Html.ActionLink("Volver al listado", "Index",
        null, new { @class = "btn btn-default" })
}
