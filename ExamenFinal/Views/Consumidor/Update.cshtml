
@model ExamenFinal.Models.Consumidor

@{
    ViewBag.Title = "Actualizar consumidor";
}

<h2>Actualizar consumidor</h2>

@using (Html.BeginForm("Update", "Consumidor", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.dnicont)

    <div class="form-group">
        @Html.LabelFor(m => m.dnicont, "DNI")
        @Html.TextBoxFor(m => m.dnicont,
            new { @class = "form-control", @readonly = "readonly" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.nomcont, "Nombre")
        @Html.TextBoxFor(m => m.nomcont,
            new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.nomcont)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.apecont, "Apellido")
        @Html.TextBoxFor(m => m.apecont,
            new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.apecont)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.emailcont, "Correo")
        @Html.TextBoxFor(m => m.emailcont,
            new { @class = "form-control", type = "email" })
        @Html.ValidationMessageFor(m => m.emailcont)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.idpais, "Código de país")
        @Html.TextBoxFor(m => m.idpais,
            new { @class = "form-control", maxlength = "3" })
        @Html.ValidationMessageFor(m => m.idpais)
    </div>

    <button type="submit" class="btn btn-primary">
        Actualizar
    </button>

    @Html.ActionLink("Volver", "Index", null,
        new { @class = "btn btn-default" })
}
